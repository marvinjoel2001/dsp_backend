# ==========================================
# OpenDSP Backend — Environment Template (.env.example)
# ==========================================

# 1. Server Configuration
PORT=3000
NODE_ENV=development

# 2. Database Connection (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=open_dsp_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# 3. Redis In-Memory Engine (Geo Spatial Tracking, Pub/Sub & BullMQ Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 4. JWT Authentication Secrets
JWT_SECRET=super_secret_dsp_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# 5. Pricing, Quoting & Matchmaking Engine Parameters
BASE_FARE=2.50
PER_KM_RATE=1.20
PER_MINUTE_RATE=0.25
MAX_SEARCH_RADIUS_KM=5.0
ORDER_OFFER_TIMEOUT_SEC=30
QUOTE_TTL_MINUTES=15

# 6. Mapbox Public Configuration (NO Google Maps)
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here
