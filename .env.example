# ==========================================
# Chiringuito DSP Backend — Variables de Entorno (Render / Cloud / Local)
# ==========================================

# 1. Configuración del Servidor
PORT=10000
NODE_ENV=production

# 2. Base de Datos PostgreSQL (Render / Supabase / Neon / Local)
# Opción A (Recomendada en Render): Connection String directa
DATABASE_URL=postgres://usuario:password@hostname.render.com:5432/chiringuito_dsp_db

# Opción B: Variables individuales (Desarrollo local)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=chiringuito_dsp_db
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false

# 3. Redis In-Memory Engine (BullMQ Colas, Redis GEO & Telemetría en Vivo)
# Opción A (Recomendada en Render / Upstash): Connection String
REDIS_URL=redis://default:password@hostname:6379

# Opción B: Variables individuales (Desarrollo local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 4. Seguridad y JWT
JWT_SECRET=super_secret_jwt_key_chiringuito_dsp_2026
JWT_EXPIRES_IN=7d

# 5. Tarifas y Parámetros de Despacho (en Bolivianos Bs.)
BASE_FARE=5.00
PER_KM_RATE=2.50
PER_MINUTE_RATE=0.50
MAX_SEARCH_RADIUS_KM=5.0
ORDER_OFFER_TIMEOUT_SEC=30
QUOTE_TTL_MINUTES=15

# 6. Firebase Cloud Messaging (Push Notifications de Alta Prioridad para conductores)
# Obtener en Consola Firebase -> Configuración del Proyecto -> Cloud Messaging -> Clave del servidor (Legacy)
FIREBASE_SERVER_KEY=tu_firebase_server_key_aqui
FIREBASE_PROJECT_ID=chiringuito-dsp
